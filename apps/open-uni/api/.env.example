# Copy to .env and fill in. Every key is optional for the app to start —
# each feature checks only the keys it needs:
#   detect/sync lectures → OPENU_*
#   transcribe           → OPENU_* + GROQ_API_KEY
#   summarize            → GEMINI_API_KEY or ANTHROPIC_API_KEY
# The settings page shows which ones are set.

# Open University (OPAL) login
OPENU_USERNAME=
OPENU_PASSWORD=
OPENU_ID=

# Transcription (Groq Whisper) — free, get a key: https://console.groq.com/keys
GROQ_API_KEY=

# Summarization — set at least one
# Gemini — free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Anthropic — paid: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional tuning
# SUMMARIZE_BACKEND=gemini       # gemini | claude — used when both keys are set
# GEMINI_MODEL=gemini-2.5-flash
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# WHISPER_PROMPT=הרצאה אקדמית. עשוי להכיל מונחים טכניים באנגלית.
# WHISPER_CONCURRENCY=2          # increase to 3-4 only if not on Groq free tier
# OUTPUT_LANG=he                 # he | en
# PORT=3001

# ── Remote / multi-user mode only (paused — see docs/adr/0002) ──────────────
# Leave GOOGLE_CLIENT_ID unset for local mode: no login, API bound to 127.0.0.1.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# JWT_SECRET=                    # openssl rand -hex 32
# API_ORIGIN=http://127.0.0.1:3001
# WEB_ORIGIN=http://127.0.0.1:3002
