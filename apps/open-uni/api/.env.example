# API keys
# GROQ_API_KEY is required — used for transcription (Whisper)
GROQ_API_KEY=your_groq_key_here
# GEMINI_API_KEY — used for summarization (default backend)
GEMINI_API_KEY=your_gemini_key_here
# ANTHROPIC_API_KEY — optional, enables Claude as a summarization backend
ANTHROPIC_API_KEY=your_anthropic_key_here

# Whisper (Groq API)
# Optional: seed Whisper with domain-specific terms to improve Hebrew/English accuracy
WHISPER_PROMPT=הרצאה אקדמית. עשוי להכיל מונחים טכניים באנגלית.
# Parallel transcription requests (keep at 2 on Groq free tier)
WHISPER_CONCURRENCY=2          # increase to 3-4 only if not on free tier

# Summarization backend (default: gemini)
SUMMARIZE_BACKEND=gemini       # gemini | claude
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Misc
OUTPUT_LANG=he                 # he = Hebrew output, en = English

# Server
PORT=3001
# Must use the same hostname (localhost vs 127.0.0.1) as NEXT_PUBLIC_API_URL
# in the web app's .env.local — a mismatch breaks the auth cookie (it's set
# on whichever host API_ORIGIN points the Google OAuth callback at, and
# won't be sent back if the web app calls the API on a different-looking host).
API_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3002

# Auth — required, sign JWTs for the login session. Generate with: openssl rand -hex 32
JWT_SECRET=

# Google OAuth login — create a Web OAuth client at console.cloud.google.com
# and register ${API_ORIGIN}/api/auth/google/callback as an authorized redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
